# Database
DATABASE_URI=mongodb://127.0.0.1/timebite-cyra-site

# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# Site
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Beta signup form (POST target) and Substack embed/link
NEXT_PUBLIC_BETA_SIGNUP_URL=
NEXT_PUBLIC_SUBSTACK_EMBED_URL=

# Cloudflare R2 (media storage)
# Payload media currently writes to local disk via src/collections/Media.ts.
# For any non-local deploy, wire an object-storage adapter or mount persistent storage.
# If you use R2, keep these values in sync with your storage adapter config.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
