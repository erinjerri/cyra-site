# Database
DATABASE_URI=mongodb://127.0.0.1/timebite-cyra-site

# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# Site
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Beta signup form POST target. Optional.
# When set, the beta section renders an email form posting here. When unset it
# renders a link to the CMS-managed beta URL instead — a form with nowhere to
# post looks like it worked and silently loses the address.
#
# The beta DESTINATION is not an env var: it lives in Payload at
# /admin > Globals > Site Settings > Beta call to action, so it can be
# repointed without a deploy. Same for any individual block's button.
NEXT_PUBLIC_BETA_SIGNUP_URL=

# Legacy. Superseded by the Substack button in Site Settings / block CTAs.
NEXT_PUBLIC_SUBSTACK_EMBED_URL=

# ---------------------------------------------------------------------------
# Cloudflare R2 (media storage)
# ---------------------------------------------------------------------------
# Leave USE_R2_STORAGE unset for local dev: uploads go to public/media on disk.
# REQUIRED for any real deploy — without it, uploaded files are lost on every
# redeploy. Full setup walkthrough: docs/MediaStorage.md
USE_R2_STORAGE=false

# From Cloudflare dashboard > R2 > your bucket
R2_BUCKET=

# Either set R2_ACCOUNT_ID (endpoint is derived from it), or set R2_ENDPOINT.
R2_ACCOUNT_ID=
R2_ENDPOINT=

# R2 > Manage API Tokens > Create API Token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public hostname that serves the bucket: a custom domain such as
# media.creatingyourreality.co, or the bucket's r2.dev subdomain.
# When set, files are served directly from R2 instead of proxied through the app.
R2_PUBLIC_HOSTNAME=

# Leave unset unless your provider needs virtual-hosted style URLs.
# R2_FORCE_PATH_STYLE=true

# Optional: analytics dashboard
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_ANALYTICS_DASHBOARD_URL=
